{
  "name": "eshantva-3d-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/next-dev.mjs",
    "build": "npm run validate:catalog && npm run validate:projects && next build && node scripts/cleanup-static-export.mjs && npm run test:stage1:static && npm run test:customer-only-export",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:stage1 && npm run test:catalog && npm run test:custom-order && npm run test:bulk-order && npm run test:services && npm run test:materials && npm run test:our-work && npm run test:how-it-works && npm run test:faq && npm run test:about && npm run test:contact && npm run test:cart && npm run test:checkout && npm run test:account && npm run test:dashboard && npm run test:order-detail && npm run test:customer-files && npm run test:admin && npm run test:admin-orders && npm run test:admin-artifacts && npm run test:admin-customers && npm run test:admin-requests && npm run test:customer-only && npm run test:upload-validation && npm run test:upload-handlers && npm run test:notifications && npm run test:edge-local-boundary && npm run test:request-notifications && npm run test:edge-local-semantic && npm run test:admin-pagination && npm run test:cors-origin",
    "test:stage1": "node --import tsx scripts/customer-foundation-tests.ts",
    "test:stage1:static": "node --import tsx scripts/stage1-static-output-tests.ts",
    "test:catalog": "node --import tsx scripts/catalog-tests.ts",
    "test:custom-order": "node --import tsx scripts/custom-order-tests.ts",
    "test:bulk-order": "node --import tsx scripts/bulk-order-tests.ts",
    "test:services": "node --import tsx scripts/services-tests.ts",
    "test:materials": "node --import tsx scripts/materials-tests.ts",
    "validate:catalog": "node --import tsx scripts/validate-catalog.ts",
    "qa:visual": "node scripts/visual-qa.mjs",
    "qa:connected": "node scripts/connected-visual-qa.mjs",
    "qa:product": "node scripts/product-detail-qa.mjs",
    "qa:custom-order": "node scripts/custom-order-qa.mjs",
    "qa:bulk-order": "node scripts/bulk-order-qa.mjs",
    "qa:services": "node scripts/services-qa.mjs",
    "qa:materials": "node scripts/materials-qa.mjs",
    "test:our-work": "node --import tsx scripts/our-work-tests.ts",
    "validate:projects": "node --import tsx scripts/validate-projects.ts",
    "test:how-it-works": "node --import tsx scripts/how-it-works-tests.ts",
    "test:faq": "node --import tsx scripts/faq-tests.ts",
    "test:about": "node --import tsx scripts/about-tests.ts",
    "test:contact": "node --import tsx scripts/contact-tests.ts",
    "test:cart": "node --import tsx scripts/cart-tests.ts",
    "test:checkout": "node --import tsx scripts/checkout-tests.ts",
    "test:account": "node --import tsx scripts/account-tests.ts",
    "test:dashboard": "node --import tsx scripts/dashboard-tests.ts",
    "test:order-detail": "node --import tsx scripts/order-detail-tests.ts",
    "test:customer-files": "node --import tsx scripts/customer-files-tests.ts",
    "test:admin": "node --import tsx scripts/admin-tests.ts",
    "test:admin-orders": "node --import tsx scripts/admin-orders-tests.ts",
    "test:admin-customers": "node --import tsx scripts/admin-customers-tests.ts",
    "test:admin-requests": "node --import tsx scripts/admin-requests-tests.ts",
    "test:admin-artifacts": "node --import tsx scripts/admin-artifacts-tests.ts",
    "test:customer-only": "node scripts/customer-only-source-tests.mjs && node scripts/customer-only-boundary-tests.mjs",
    "test:customer-only-export": "node scripts/customer-only-export-tests.mjs",
    "qa:customer-only-public": "node scripts/customer-only-browser-qa.mjs",
    "test:admin-request-attachment-contract": "node scripts/admin-request-attachment-contract-tests.mjs",
    "test:upload-validation": "node --import tsx scripts/upload-validation-tests.ts",
    "test:upload-handlers": "node --import tsx scripts/upload-handler-tests.mjs",
    "test:notifications": "node --import tsx scripts/notification-tests.ts && node scripts/notification-release-guard-tests.mjs",
    "test:host-neutral-http": "node scripts/host-neutral-http-tests.mjs",
    "test:edge-boundary-parity": "node scripts/edge-boundary-parity-tests.mjs",
    "test:request-notifications": "node --import tsx scripts/request-notification-handler-tests.mjs",
    "test:edge-semantic-parity": "node scripts/edge-semantic-parity-tests.mjs",
    "test:admin-pagination": "node scripts/admin-pagination-tests.mjs",
    "test:edge-local-boundary": "node scripts/edge-local-boundary-tests.mjs",
    "test:edge-local-semantic": "node scripts/edge-local-semantic-tests.mjs",
    "test:operator-parity": "npm run test:edge-boundary-parity && npm run test:edge-semantic-parity",
    "test:operator-stage1": "node --import tsx scripts/stage1-foundation-tests.ts",
    "test:cors-origin": "node scripts/cors-origin-tests.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "^1.31.0",
    "next": "16.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "tus-js-client": "4.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/tus-js-client": "^1.8.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "playwright": "^1.62.1",
    "serve": "^14.2.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
