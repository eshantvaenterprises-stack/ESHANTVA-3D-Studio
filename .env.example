# Public browser configuration for the dedicated ESHANTVA Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set these when the public site/domain is known.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BASE_PATH=

# Edge Function secrets/configuration are set in Supabase, not exposed to the browser:
# RATE_LIMIT_SALT=
# CUSTOM_ORDER_ALLOWED_ORIGINS=
# BULK_ORDER_ALLOWED_ORIGINS=
# CONTACT_ALLOWED_ORIGINS=
# BULK_CATALOG_MODE=sample
# BULK_ACTIVE_PRODUCTS_JSON=[]

# Page 14 Checkout. Public flags expose only delivery methods that have a real
# server-side quoting path. Keep false until matching server configuration exists.
NEXT_PUBLIC_CHECKOUT_LOCAL_DELIVERY_ENABLED=false
NEXT_PUBLIC_CHECKOUT_SHIPPING_ENABLED=false
# NEXT_PUBLIC_SUPABASE_CHECKOUT_FUNCTION_URL=

# Supabase Edge Function configuration, never NEXT_PUBLIC:
# CHECKOUT_ALLOWED_ORIGINS=
# CHECKOUT_ENABLED_DELIVERY_METHODS=pickup
# CHECKOUT_DELIVERY_RATES_JSON=[]
# CHECKOUT_RETURN_URL_BASE=
# A verified payment provider/credentials are intentionally not named here until selected.

# Page 15 Account Access uses Supabase Auth through the same public browser client.
# Hosted-project settings are configured in Supabase Dashboard, not committed here:
# - Email/password provider and email-confirmation policy
# - Anonymous Sign-Ins (required by existing guest flows)
# - Manual identity linking (required to convert an anonymous user to a permanent account)
# - Auth Site URL / Redirect URLs for /account/ and /account/reset/
# - Production SMTP provider for reliable confirmation/recovery email

# Page 16 Customer Dashboard (browser-safe function override only; optional)
# NEXT_PUBLIC_SUPABASE_DASHBOARD_FUNCTION_URL=https://<project>.supabase.co/functions/v1/customer-dashboard-api
# Edge Function server setting: DASHBOARD_ALLOWED_ORIGINS=https://your-production-origin.example

# Admin Plane Phase 1 (server configuration, never NEXT_PUBLIC except optional function URL override)
# ADMIN_ALLOWED_ORIGINS=https://your-production-origin.example
# NEXT_PUBLIC_SUPABASE_ADMIN_FUNCTION_URL=https://<project>.supabase.co/functions/v1/admin-api
# Bootstrap is a privileged database operation using an existing trusted Supabase Auth user UUID.
# Never authorize Admin from an email string in browser code.

# Optional override for the Phase 4 Admin artifact Edge Function.
# NEXT_PUBLIC_SUPABASE_ADMIN_ARTIFACT_FUNCTION_URL=https://<project>.supabase.co/functions/v1/admin-artifact-api
# Public is the safe default. Use internal only behind deployment protection.
NEXT_PUBLIC_RETAIL_SURFACE=public

# Recruitment core (public values only; privileged secrets stay in Supabase Edge Functions)
# Closed-registration candidate/legacy admin UI stays disabled unless the matching
# staging or production URL + publishable key are EXPLICITLY set and tested.
# Set to true only on the approved protected preview; leave false in production
# until Auth/RLS, invite and historical applicant tests pass.
NEXT_PUBLIC_RECRUITMENT_PORTAL_ENABLED=false
NEXT_PUBLIC_SUPABASE_RECRUITMENT_FUNCTION_URL=
NEXT_PUBLIC_SUPABASE_ADMIN_RECRUITMENT_FUNCTION_URL=

# Recruitment Edge Function server configuration (never NEXT_PUBLIC):
# PUBLIC_SITE_ORIGINS=https://your-public-origin.example
# ADMIN_SITE_ORIGINS=https://your-admin-origin.example
# PUBLIC_SITE_URL=https://your-public-origin.example

# STAGE 2C EXTENDED PAYMENT VAULT (disabled by default)
NEXT_PUBLIC_SUPABASE_RECRUITMENT_BANK_FUNCTION_URL=
# Server-only, never NEXT_PUBLIC: set only after purpose, retention and key-custody approval
RECRUITMENT_BANK_DETAILS_ENABLED=false
# 32 cryptographically random bytes, base64; key rotation and disaster recovery required
RECRUITMENT_BANK_AES_KEY_B64=
# Extended pipeline remains disabled until isolated DB + authenticated tests
RECRUITMENT_EXTENDED_MUTATIONS_ENABLED=false
RECRUITMENT_EXTENDED_PUBLICATION_ENABLED=false
RECRUITMENT_EXTENDED_EXPORTS_ENABLED=false
RECRUITMENT_TRAINING_EMAIL_ENABLED=false

# Public schedule: requires validated immutable global publication; default disabled
NEXT_PUBLIC_SUPABASE_RECRUITMENT_TRAINING_PUBLIC_FUNCTION_URL=
RECRUITMENT_PUBLIC_TRAINING_SCHEDULE_ENABLED=false
# PII export columns require separate owner approval
RECRUITMENT_EXPORT_PERSONAL_COLUMNS_ENABLED=false

# Exact published-revision QR verification: owner-confirmed URL; disabled until raster/runtime tests
RECRUITMENT_EXTENDED_QR_ENABLED=false
RECRUITMENT_PUBLIC_VERIFY_URL=

NEXT_PUBLIC_SUPABASE_RECRUITMENT_TRAINING_EMAIL_FUNCTION_URL=
RECRUITMENT_RESEND_API_KEY=
RECRUITMENT_VERIFIED_EMAIL_SENDER=

# New customer website modules: keep disabled until authorized backend/migration release.
NEXT_PUBLIC_WEBSITE_FEATURES_ENABLED=false
NEXT_PUBLIC_REAL_PORTFOLIO_ENABLED=false
# Edge-only configuration (never use NEXT_PUBLIC_ for these):
# WEBSITE_FEATURES_ENABLED=false
# WEBSITE_ALLOWED_ORIGINS=<approved origins>
# CMS_PUBLICATION_ENABLED=false
# CMS_REAL_PORTFOLIO_ENABLED=false
# CMS_APPROVED_PROJECT_ASSETS=<comma-separated independently approved public /images/ paths>
