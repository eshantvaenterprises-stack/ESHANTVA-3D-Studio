{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "rewrites": [
    {
      "source": "/admin/customers/:customerRef",
      "destination": "/admin/customer/"
    },
    {
      "source": "/admin/customers/:customerRef/",
      "destination": "/admin/customer/"
    },
    {
      "source": "/admin/requests/custom/:reference",
      "destination": "/admin/custom-request/"
    },
    {
      "source": "/admin/requests/custom/:reference/",
      "destination": "/admin/custom-request/"
    },
    {
      "source": "/admin/requests/bulk/:reference",
      "destination": "/admin/bulk-request/"
    },
    {
      "source": "/admin/requests/bulk/:reference/",
      "destination": "/admin/bulk-request/"
    },
    {
      "source": "/admin/orders/:reference",
      "destination": "/admin/order/"
    },
    {
      "source": "/admin/orders/:reference/",
      "destination": "/admin/order/"
    },
    {
      "source": "/account/orders/:reference/files",
      "destination": "/account/order-files/"
    },
    {
      "source": "/account/orders/:reference/files/",
      "destination": "/account/order-files/"
    },
    {
      "source": "/account/orders/:reference",
      "destination": "/account/orders/"
    },
    {
      "source": "/account/orders/:reference/",
      "destination": "/account/orders/"
    }
  ]
}
